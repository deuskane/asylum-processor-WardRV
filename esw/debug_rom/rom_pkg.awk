# -----------------------------------------------------------------------------
# hdl/debug/WardRV_dbg_rom_pkg.vhd from debug_rom.hex (one word per line) and
# debug_rom.lst (instructions, in the same order, for the comments)
# Usage : awk -f rom_pkg.awk debug_rom.lst debug_rom.hex
# -----------------------------------------------------------------------------
FNR == NR {
    # objdump line : "fffff800:<tab>7b241073<spaces><tab>csrw<tab>dscratch0,s0"
    if ($0 ~ /^[0-9a-f]+:\t[0-9a-f]+ /) {
        split($0, f, "\t")
        asm[n++] = f[3] (f[4] == "" ? "" : " " f[4])
    }
    next
}
FNR == 1 {
    print "-------------------------------------------------------------------------------"
    print "-- Title      : WardRV"
    print "-- Project    : "
    print "-------------------------------------------------------------------------------"
    print "-- File       : WardRV_dbg_rom_pkg.vhd"
    print "-- Author     : Mathieu Rosiere"
    print "-------------------------------------------------------------------------------"
    print "-- Description:"
    print "-- Debug ROM of the Debug Module, offset 0x000 of the debug memory."
    print "-- GENERATED by esw/debug_rom/Makefile from debug_rom.S : do not edit."
    print "-------------------------------------------------------------------------------"
    print ""
    print "library ieee;"
    print "use     ieee.std_logic_1164.all;"
    print ""
    print "library asylum;"
    print "use     asylum.WardRV_debug_pkg.all;"
    print ""
    print "package WardRV_dbg_rom_pkg is"
    print ""
    print "  constant DBG_ROM_CONTENT : dbg_words_t :="
}
{
    printf "    %s%2d => x\"%s\"  -- %s\n", (FNR == 1 ? "(" : ","), FNR-1, toupper($1), asm[FNR-1]
}
END {
    print "    );"
    print ""
    print "end package WardRV_dbg_rom_pkg;"
}
