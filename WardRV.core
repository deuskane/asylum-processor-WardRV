CAPI=2:

#-----------------------------------------------------------------------------
# Title      : WardRV Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : WardRV.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-01-24  0.0.1    mrosiere Created
# 2026-06-02  0.0.2    mrosiere fsm : add state trap
# 2026-09-15  0.0.3    mrosiere fsm : use ram2r1w
# 2026-10-05  0.0.4    mrosiere fsm : fix CSRRC/CSRRCI and BLT/BGE on signed overflow
#                               Compare compliance signature (SIGNATURE_FILE)
#                               Fix default/lint_nxmap toplevel
#                               Compliance : ACT3 (esw/compliance_act3) and ACT4 (esw/compliance_act4) suites
# 2026-10-09  0.0.5    mrosiere debug : RISC-V Debug Spec 1.0 debug unit (JTAG TAP/DTM, DMI CDC,
#                               Debug Module, SBA), fsm : debug mode, triggers, EBREAK_EXCEPTION,
#                               MRET effect only in WRITEBACK
#                               Add sim_debug_tap, sim_debug_dm, sim_debug_system
#                               Add cosim_openocd (OpenOCD + GDB co-simulation)
#                               Add lint_ghdl_synth_* (ghdl --synth of syn/WardRV_wrapper)
#-----------------------------------------------------------------------------

name        : asylum:processor:WardRV:0.0.5
description : WardRV - Academic RISCV processor

#=========================================
filesets:
#=========================================
  #---------------------------------------
  files_hdl:
  #---------------------------------------
    files        :
      # Common package
      - hdl/RV_pkg.vhd
      - hdl/WardRV_pkg.vhd
      - hdl/WardRV_stats_pkg.vhd
      - hdl/debug/WardRV_debug_pkg.vhd

      # Bridge
      - hdl/bridge/dmem2sbi.vhd
      - hdl/bridge/imem2sbi.vhd

      # Instruction Set Simulator
      - hdl/iss/WardRV_iss_pkg.vhd
      - hdl/iss/WardRV_iss.vhd

      # Debug Unit (RISC-V Debug Spec 1.0)
      - hdl/debug/WardRV_dbg_rom_pkg.vhd
      - hdl/debug/WardRV_dbg_tap.vhd
      - hdl/debug/WardRV_dbg_dtm.vhd
      - hdl/debug/WardRV_dbg_dmi_cdc.vhd
      - hdl/debug/WardRV_dbg_jtag.vhd
      - hdl/debug/WardRV_dbg_dm_mem.vhd
      - hdl/debug/WardRV_dbg_sba.vhd
      - hdl/debug/WardRV_dbg_dm.vhd
      - hdl/debug/WardRV_debug.vhd

      # FSM Version
      - hdl/fsm/WardRV_decode_pkg.vhd
      - hdl/fsm/WardRV_fsm_fetch.vhd
      - hdl/fsm/WardRV_fsm_alu.vhd
      - hdl/fsm/WardRV_fsm_decode.vhd
      - hdl/fsm/WardRV_fsm_regfile.vhd
      - hdl/fsm/WardRV_fsm_memory.vhd
      - hdl/fsm/WardRV_fsm_csr.vhd
      - hdl/fsm/WardRV_fsm_trigger.vhd
      - hdl/fsm/WardRV_fsm_debug.vhd
      - hdl/fsm/WardRV_fsm.vhd
      - hdl/fsm/sbi_WardRV_fsm.vhd

    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - ">=asylum:utils:pkg:1.0.0"
      - ">=asylum:component:ram:1.0.0"
      - ">=asylum:target:techmap:1.0.0"

  #---------------------------------------
  files_sim:
  #---------------------------------------
    files        :
      - sim/WardRV_vips.vhd                                          
      - sim/tb_WardRV_pkg.vhd                                        
      - sim/tb_WardRV.vhd                                            
      - sim/tb_WardRV_iss.vhd                                        
      - esw/testcase/firmware.hex                                    : {file_type : user, copyto : firmware.hex}

    file_type    : vhdlSource-2008
    depend :
      - bitvis:verification:uvvm

  #---------------------------------------
  files_sim_debug:
  #---------------------------------------
    files        :
      - sim/tb_WardRV_dbg_jtag.vhd
      - sim/tb_WardRV_dbg_dm.vhd
      - sim/tb_WardRV_debug.vhd
      - esw/debug/debug_fw.hex                                       : {file_type : user, copyto : debug/debug_fw.hex}

    file_type    : vhdlSource-2008

  #---------------------------------------
  files_sim_openocd:
  #---------------------------------------
    files        :
      - sim/openocd/rbb_pkg.vhd
      - sim/tb_WardRV_openocd.vhd
      - sim/openocd/remote_bitbang.c                                 : {file_type : user, copyto : openocd/remote_bitbang.c}
      - sim/openocd/wardrv_sim.cfg                                   : {file_type : user, copyto : openocd/wardrv_sim.cfg}
      - sim/openocd/scenario.py                                      : {file_type : user, copyto : openocd/scenario.py}
      - sim/openocd/launch.sh                                        : {file_type : user, copyto : openocd/launch.sh}
      - sim/openocd/check.sh                                         : {file_type : user, copyto : openocd/check.sh}
      - esw/openocd/fw.elf                                           : {file_type : user, copyto : openocd/fw.elf}
      - esw/openocd/fw.hex                                           : {file_type : user, copyto : openocd/fw.hex}

    file_type    : vhdlSource-2008

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/WardRV_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"

  #---------------------------------------
  # Compliance Testcases : one fileset per test
  #---------------------------------------
  files_act3_add_01:
    files:
      - esw/compliance_act3/benchs/add-01.hex       : {file_type : user, copyto : act3/add-01.hex}
      - esw/compliance_act3/benchs/add-01.signature : {file_type : user, copyto : act3/add-01.signature}

