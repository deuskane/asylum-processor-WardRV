#=========================================
targets:
#=========================================

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : sbi_WardRV_fsm
    default_tool    : ghdl

  #---------------------------------------
  sim: &sim
  #---------------------------------------
    << : *default
    description     : default rule to sim (DON'T RUN)
    default_tool    : ghdl
    toplevel        : tb_WardRV
    filesets_append :
      - files_sim
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  lint_nxmap:
  #- --------------------------------------
    << : *default
    description  : NanoXplore NG_MEDIUM Board
    default_tool : nxmap
    flags :
      TARGET  : NANOXPLORE_NG_MEDIUM
    tools:
      nxmap:
        fpga         : NG-MEDIUM
        program      : False
        logical_name : asylum
    toplevel     : sbi_WardRV_fsm

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation) of
  # WardRV_wrapper (core + debug unit)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
  #---------------------------------------
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of WardRV_wrapper, core + debug unit)
    toplevel        : asylum.WardRV_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--ieee-asserts=disable"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of WardRV_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:generators) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_nodebug : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of WardRV_wrapper, without debug unit
    parameters      :
      - DEBUG_ENABLE=false
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_debug :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit without trigger
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=0

  #---------------------------------------
  lint_ghdl_synth_debug_trig2 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit with 2 triggers
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=2

  #---------------------------------------
  lint_ghdl_synth_debug_sba :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit with system bus access
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=0
      - SBA_ENABLE=true

  #---------------------------------------
  lint_ghdl_synth_debug_full :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, every option
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=2
      - SBA_ENABLE=true
      - EBREAK_EXCEPTION=true
      - RESETHALTREQ_ENABLE=true

  #---------------------------------------
  lint_ghdl_synth_debug_large :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, 4 triggers, large program buffer
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=4
      - PROGBUF_SIZE=8
      - DATA_COUNT=12

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *sim
    description     : Basic testcase
    parameters      :
      - FIRMWARE_FILE=firmware.hex
      - VERBOSE=false
  
  #---------------------------------------
  # Debug Unit
  #---------------------------------------
  sim_debug_tap:
    << : *sim
    description     : Debug - JTAG TAP + DTM + DMI CDC unit test (IEEE 1149.1 TAP, dtmcs, dmi busy / failed / dmireset / dmihardreset, slow and fast clk)
    toplevel        : tb_WardRV_dbg_jtag
    filesets_append : [files_sim, files_sim_debug]

  sim_debug_dm:
    << : *sim
    description     : Debug - Debug Module unit test (DMI record, hart model, abstract commands, cmderr, abstractauto, SBA)
    toplevel        : tb_WardRV_dbg_dm
    filesets_append : [files_sim, files_sim_debug]

  sim_debug_system:
    << : *sim
    description     : Debug - System test, WardRV_fsm + WardRV_debug driven through JTAG (halt, registers, memory, step, ebreak, triggers, resethaltreq)
    toplevel        : tb_WardRV_debug
    filesets_append : [files_sim, files_sim_debug]
    parameters      : [FIRMWARE_FILE=debug/debug_fw.hex, VERBOSE=false]

  #---------------------------------------
  # Debug Unit : OpenOCD + GDB co-simulation. Not a sim_ target (not in
  # nonreg_sim nor in the CI) : needs openocd and gdb-multiarch in the PATH
  #---------------------------------------
  cosim_openocd:
    << : *sim
    description     : Debug - OpenOCD + GDB co-simulation, WardRV_fsm + WardRV_debug (SBA) driven by OpenOCD (remote_bitbang, VHPIDIRECT) and a GDB scenario (sim/openocd)
    toplevel        : tb_WardRV_openocd
    filesets_append : [files_sim, files_sim_openocd]
    parameters      : [FIRMWARE_FILE=openocd/fw.hex, VERBOSE=false]
    hooks :
      pre_build     : [rbb_build]
      pre_run       : [openocd_launch]
      post_run      : [openocd_check]

  #---------------------------------------
  # Compliance Testcases : ACT3 (riscv-arch-test 3.10.0, signature)
  #---------------------------------------
  sim_compliance_act3_add_01:
    << : *sim
    filesets_append : [files_sim, files_act3_add_01]
    description: ACT3 add-01 testcase
    parameters: [FIRMWARE_FILE=act3/add-01.hex, GOLDEN_FILE=act3/add-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

