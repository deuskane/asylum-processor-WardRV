#=========================================
targets:
#=========================================

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : sbi_WardRV_fsm
    default_tool    : ghdl

  #---------------------------------------
  sim: &sim
  #---------------------------------------
    << : *default
    description     : default rule to sim (DON'T RUN)
    default_tool    : ghdl
    toplevel        : tb_WardRV
    filesets_append :
      - files_sim
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation) of
  # WardRV_wrapper (sbi_WardRV_fsm with flat SBI ports, WardRV_debug
  # with DEBUG_ENABLE)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
  #---------------------------------------
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of WardRV_wrapper)
    toplevel        : asylum.WardRV_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--ieee-asserts=disable"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of WardRV_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:ghdl_synth) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
  #---------------------------------------
    << : *lint_ghdl
    description     : Synthesis check of WardRV_wrapper, word address on 32 bits (default generics)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_byte_addr :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, byte address on 32 bits
    parameters      :
      - IADDR_WIDTH=32
      - IADDR_ALIGN_BITS=0

  #---------------------------------------
  lint_ghdl_synth_picosoc :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, PicoSoC (word address, ROM of 1024 words)
    parameters      :
      - IADDR_WIDTH=10
      - IADDR_ALIGN_BITS=2

  #---------------------------------------
  lint_ghdl_synth_ebreak_exception :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, EBREAK_EXCEPTION without debug unit
    parameters      :
      - EBREAK_EXCEPTION=true

  #---------------------------------------
  lint_ghdl_synth_debug :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, abstract commands and program buffer of 2 words, no trigger
    parameters      :
      - DEBUG_ENABLE=true

  #---------------------------------------
  lint_ghdl_synth_debug_pb0 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit without program buffer
    parameters      :
      - DEBUG_ENABLE=true
      - PROGBUF_SIZE=0

  #---------------------------------------
  lint_ghdl_synth_debug_trig2 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, 2 triggers
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=2

  #---------------------------------------
  lint_ghdl_synth_debug_sba :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, System Bus Access
    parameters      :
      - DEBUG_ENABLE=true
      - SBA_ENABLE=true

  #---------------------------------------
  lint_ghdl_synth_debug_full :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, 2 triggers, SBA, EBREAK_EXCEPTION, RESETHALTREQ_ENABLE
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=2
      - SBA_ENABLE=true
      - EBREAK_EXCEPTION=true
      - RESETHALTREQ_ENABLE=true

  #---------------------------------------
  lint_ghdl_synth_debug_large :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, 4 triggers, program buffer of 8 words, 12 data registers
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=4
      - PROGBUF_SIZE=8
      - DATA_COUNT=12

  #---------------------------------------
  lint_ghdl_synth_debug_max :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of WardRV_wrapper, debug unit, maximum configuration (program buffer of 16 words, 12 data registers, 8 triggers, SBA, EBREAK_EXCEPTION, RESETHALTREQ_ENABLE)
    parameters      :
      - DEBUG_ENABLE=true
      - NB_TRIGGERS=8
      - PROGBUF_SIZE=16
      - DATA_COUNT=12
      - SBA_ENABLE=true
      - EBREAK_EXCEPTION=true
      - RESETHALTREQ_ENABLE=true

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *sim
    description     : Basic testcase
    parameters      :
      - FIRMWARE_FILE=firmware.hex
      - VERBOSE=false

  #---------------------------------------
  # Bridge
  #---------------------------------------
  sim_bridge_imem2sbi:
    << : *sim
    description     : Bridge - imem2sbi fetching from sbi_ram (asynchronous and synchronous read)
    toplevel        : tb_imem2sbi
    filesets_append : [files_sim, files_sim_bridge]
  
  #---------------------------------------
  # Interrupt : meip_i driven by the program (tb_WardRV, C_MEIP_ADDR)
  #---------------------------------------
  sim_irq:
    << : *sim
    description     : Interrupt - meip_i pending during the CSR instruction that clears / sets mstatus.MIE or mie.MEIE (esw/irq)
    filesets_append : [files_sim, files_sim_irq]
    parameters      : [FIRMWARE_FILE=irq/irq_fw.hex, VERBOSE=false]

  #---------------------------------------
  # Debug unit : one sim_dbg_<testbench>_<scenario> target per scenario,
  # chosen at run time by the generic TEST. The bases dbg_<testbench> are
  # not sim_ targets (no CI job), they run any scenario :
  #   fusesoc --cores-root . run --target dbg_jtag <VLNV> --TEST=<scenario>
  # No waveform (long simulations) : add --fst=dut.fst to run_options.
  #---------------------------------------
  dbg_jtag: &dbg_jtag
  #---------------------------------------
    << : *default
    description     : Base of sim_dbg_jtag_* (DON'T RUN alone), WardRV_dbg_jtag unit test, scenario TEST
    default_tool    : ghdl
    toplevel        : tb_WardRV_dbg_jtag
    filesets_append : [files_sim, files_sim_debug]
    parameters      : [TEST, CLK_PERIOD_NS, VERBOSE]
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--ieee-asserts=disable"]

  sim_dbg_jtag_tap:
    << : *dbg_jtag
    description     : Debug - JTAG TAP - Test-Logic-Reset (TRST*, TMS), Capture-IR, IDCODE, BYPASS
    parameters      : [TEST=tap]

  sim_dbg_jtag_dtmcs:
    << : *dbg_jtag
    description     : Debug - JTAG DTM - dtmcs fields
    parameters      : [TEST=dtmcs]

  sim_dbg_jtag_dmi:
    << : *dbg_jtag
    description     : Debug - JTAG DTM - DMI reads and writes through the CDC (clk 5x faster than TCK)
    parameters      : [TEST=dmi]

  sim_dbg_jtag_slow_dmi:
    << : *dbg_jtag
    description     : Debug - JTAG DTM - DMI reads and writes through the CDC (clk 40x slower than TCK, busy retries, requests in the end of the handshake)
    parameters      : [TEST=dmi, CLK_PERIOD_NS=2000]

  sim_dbg_jtag_busy:
    << : *dbg_jtag
    description     : Debug - JTAG DTM - sticky busy status, request ignored, dmireset, dmihardreset
    parameters      : [TEST=busy]

  #---------------------------------------
  dbg_dm: &dbg_dm
  #---------------------------------------
    << : *dbg_jtag
    description     : Base of sim_dbg_dm_* (DON'T RUN alone), WardRV_dbg_dm unit test, scenario TEST
    toplevel        : tb_WardRV_dbg_dm
    parameters      : [TEST, PROGBUF_SIZE, VERBOSE]

  sim_dbg_dm_dmcontrol:
    << : *dbg_dm
    description     : Debug - Debug Module - dmactive, dmstatus, hartinfo, abstractcs, ackhavereset, ndmreset
    parameters      : [TEST=dmcontrol]

  sim_dbg_dm_halt_resume:
    << : *dbg_dm
    description     : Debug - Debug Module - haltreq, halted, resumereq, resumeack
    parameters      : [TEST=halt_resume]

  sim_dbg_dm_abstract:
    << : *dbg_dm
    description     : Debug - Debug Module - abstract command programs (GPR / CSR read and write), postexec, program buffer, data registers
    parameters      : [TEST=abstract]

  sim_dbg_dm_cmderr:
    << : *dbg_dm
    description     : Debug - Debug Module - abstractcs.cmderr (not supported, exception, halt / resume, busy)
    parameters      : [TEST=cmderr]

  sim_dbg_dm_autoexec:
    << : *dbg_dm
    description     : Debug - Debug Module - abstractauto on data and program buffer accesses
    parameters      : [TEST=autoexec]

  sim_dbg_dm_resethaltreq:
    << : *dbg_dm
    description     : Debug - Debug Module - set / clrresethaltreq, hart reset (havereset, unavail)
    parameters      : [TEST=resethaltreq]

  sim_dbg_dm_sba:
    << : *dbg_dm
    description     : Debug - Debug Module - System Bus Access, 8 / 16 / 32 bits, autoincrement, readonaddr, readondata, sberror, sbbusyerror
    parameters      : [TEST=sba]

  sim_dbg_dm_progbuf0:
    << : *dbg_dm
    description     : Debug - Debug Module without program buffer - progbufsize 0, postexec not supported, abstract register access
    parameters      : [TEST=progbuf0, PROGBUF_SIZE=0]

  #---------------------------------------
  dbg_system: &dbg_system
  #---------------------------------------
    << : *dbg_jtag
    description     : Base of sim_dbg_system_* (DON'T RUN alone), WardRV_fsm + WardRV_debug through JTAG, scenario TEST
    toplevel        : tb_WardRV_debug
    parameters      : [TEST, EBREAK_EXCEPTION, VERBOSE]

  sim_dbg_system_halt_resume:
    << : *dbg_system
    description     : Debug - System - haltreq (cause 3, dpc), resume
    parameters      : [TEST=halt_resume]

  sim_dbg_system_registers:
    << : *dbg_system
    description     : Debug - System - GPR / CSR access with abstract commands, dpc write
    parameters      : [TEST=registers]

  sim_dbg_system_cmderr:
    << : *dbg_system
    description     : Debug - System - register that does not exist, command while running
    parameters      : [TEST=cmderr]

  sim_dbg_system_progbuf:
    << : *dbg_system
    description     : Debug - System - memory read / write through the program buffer
    parameters      : [TEST=progbuf]

  sim_dbg_system_step:
    << : *dbg_system
    description     : Debug - System - dcsr.step (cause 4, dpc of each instruction)
    parameters      : [TEST=step]

  sim_dbg_system_ebreak:
    << : *dbg_system
    description     : Debug - System - ebreak with dcsr.ebreakm (cause 1), NOP without
    parameters      : [TEST=ebreak]

  sim_dbg_system_trigger_execute:
    << : *dbg_system
    description     : Debug - System - tselect / tinfo / tdata1, execute trigger (cause 2, instruction not executed)
    parameters      : [TEST=trigger_execute]

  sim_dbg_system_trigger_store:
    << : *dbg_system
    description     : Debug - System - store trigger (cause 2, dpc of the store)
    parameters      : [TEST=trigger_store]

  sim_dbg_system_trigger_load:
    << : *dbg_system
    description     : Debug - System - load trigger (cause 2, dpc of the load)
    parameters      : [TEST=trigger_load]

  sim_dbg_system_resethaltreq:
    << : *dbg_system
    description     : Debug - System - ndmreset with resethaltreq (cause 5) and with haltreq (cause 3), dpc = reset address
    parameters      : [TEST=resethaltreq]

  sim_dbg_system_interrupt:
    << : *dbg_system
    description     : Debug - System - interrupt masked in debug mode, step without / with dcsr.stepie
    parameters      : [TEST=interrupt]

  sim_dbg_system_exc_ebreak:
    << : *dbg_system
    description     : Debug - System - EBREAK_EXCEPTION, ebreak without dcsr.ebreakm traps (mcause 3), with it enters debug mode
    parameters      : [TEST=exc_ebreak, EBREAK_EXCEPTION=true]

  sim_dbg_system_exc_trigger:
    << : *dbg_system
    description     : Debug - System - EBREAK_EXCEPTION, trigger of M-mode (dmode 0) raises a breakpoint exception
    parameters      : [TEST=exc_trigger, EBREAK_EXCEPTION=true]

  #---------------------------------------
  # OpenOCD + GDB co-simulation : one target per configuration of the debug
  # unit (program buffer, System Bus Access, triggers). Needs openocd and
  # gdb-multiarch (sim/openocd/cosim.sh, hooks run in the work root).
  #---------------------------------------
  dbg_openocd: &dbg_openocd
  #---------------------------------------
    << : *dbg_jtag
    description     : Base of sim_dbg_openocd_* (DON'T RUN alone), OpenOCD + GDB co-simulation
    toplevel        : tb_WardRV_openocd
    filesets_append : [files_sim, files_sim_openocd]
    parameters      : [PROGBUF_SIZE, DATA_COUNT, SBA_ENABLE, NB_TRIGGERS]
    hooks :
      pre_build     : [cosim_build]
      pre_run       : [cosim_start]
      post_run      : [cosim_check]

  sim_dbg_openocd_pb0_sba0_tr0:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 0, no SBA, 0 triggers
    parameters      : [PROGBUF_SIZE=0, SBA_ENABLE=false, NB_TRIGGERS=0]

  sim_dbg_openocd_pb0_sba0_tr2:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 0, no SBA, 2 triggers
    parameters      : [PROGBUF_SIZE=0, SBA_ENABLE=false, NB_TRIGGERS=2]

  sim_dbg_openocd_pb0_sba1_tr0:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 0, SBA, 0 triggers
    parameters      : [PROGBUF_SIZE=0, SBA_ENABLE=true, NB_TRIGGERS=0]

  sim_dbg_openocd_pb0_sba1_tr2:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 0, SBA, 2 triggers
    parameters      : [PROGBUF_SIZE=0, SBA_ENABLE=true, NB_TRIGGERS=2]

  sim_dbg_openocd_pb2_sba0_tr0:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 2, no SBA, 0 triggers
    parameters      : [PROGBUF_SIZE=2, SBA_ENABLE=false, NB_TRIGGERS=0]

  sim_dbg_openocd_pb2_sba0_tr2:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 2, no SBA, 2 triggers
    parameters      : [PROGBUF_SIZE=2, SBA_ENABLE=false, NB_TRIGGERS=2]

  sim_dbg_openocd_pb2_sba1_tr0:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 2, SBA, 0 triggers
    parameters      : [PROGBUF_SIZE=2, SBA_ENABLE=true, NB_TRIGGERS=0]

  sim_dbg_openocd_pb2_sba1_tr2:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - program buffer 2, SBA, 2 triggers
    parameters      : [PROGBUF_SIZE=2, SBA_ENABLE=true, NB_TRIGGERS=2]

  sim_dbg_openocd_pb16_sba1_tr8:
    << : *dbg_openocd
    description     : Debug - OpenOCD + GDB - maximum configuration, program buffer 16, 12 data, SBA, 8 triggers
    parameters      : [PROGBUF_SIZE=16, DATA_COUNT=12, SBA_ENABLE=true, NB_TRIGGERS=8]

  #---------------------------------------
  # Compliance Testcases : ACT3 (riscv-arch-test 3.10.0, signature)
  #---------------------------------------
  sim_compliance_act3_add_01:
    << : *sim
    filesets_append : [files_sim, files_act3_add_01]
    description: ACT3 add-01 testcase
    parameters: [FIRMWARE_FILE=act3/add-01.hex, GOLDEN_FILE=act3/add-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_addi_01:
    << : *sim
    filesets_append : [files_sim, files_act3_addi_01]
    description: ACT3 addi-01 testcase
    parameters: [FIRMWARE_FILE=act3/addi-01.hex, GOLDEN_FILE=act3/addi-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_and_01:
    << : *sim
    filesets_append : [files_sim, files_act3_and_01]
    description: ACT3 and-01 testcase
    parameters: [FIRMWARE_FILE=act3/and-01.hex, GOLDEN_FILE=act3/and-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_andi_01:
    << : *sim
    filesets_append : [files_sim, files_act3_andi_01]
    description: ACT3 andi-01 testcase
    parameters: [FIRMWARE_FILE=act3/andi-01.hex, GOLDEN_FILE=act3/andi-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_auipc_01:
    << : *sim
    filesets_append : [files_sim, files_act3_auipc_01]
    description: ACT3 auipc-01 testcase
    parameters: [FIRMWARE_FILE=act3/auipc-01.hex, GOLDEN_FILE=act3/auipc-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_beq_01:
    << : *sim
    filesets_append : [files_sim, files_act3_beq_01]
    description: ACT3 beq-01 testcase
    parameters: [FIRMWARE_FILE=act3/beq-01.hex, GOLDEN_FILE=act3/beq-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_bge_01:
    << : *sim
    filesets_append : [files_sim, files_act3_bge_01]
    description: ACT3 bge-01 testcase
    parameters: [FIRMWARE_FILE=act3/bge-01.hex, GOLDEN_FILE=act3/bge-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_bgeu_01:
    << : *sim
    filesets_append : [files_sim, files_act3_bgeu_01]
    description: ACT3 bgeu-01 testcase
    parameters: [FIRMWARE_FILE=act3/bgeu-01.hex, GOLDEN_FILE=act3/bgeu-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_blt_01:
    << : *sim
    filesets_append : [files_sim, files_act3_blt_01]
    description: ACT3 blt-01 testcase
    parameters: [FIRMWARE_FILE=act3/blt-01.hex, GOLDEN_FILE=act3/blt-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_bltu_01:
    << : *sim
    filesets_append : [files_sim, files_act3_bltu_01]
    description: ACT3 bltu-01 testcase
    parameters: [FIRMWARE_FILE=act3/bltu-01.hex, GOLDEN_FILE=act3/bltu-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_bne_01:
    << : *sim
    filesets_append : [files_sim, files_act3_bne_01]
    description: ACT3 bne-01 testcase
    parameters: [FIRMWARE_FILE=act3/bne-01.hex, GOLDEN_FILE=act3/bne-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_fence_01:
    << : *sim
    filesets_append : [files_sim, files_act3_fence_01]
    description: ACT3 fence-01 testcase
    parameters: [FIRMWARE_FILE=act3/fence-01.hex, GOLDEN_FILE=act3/fence-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_jal_01:
    << : *sim
    filesets_append : [files_sim, files_act3_jal_01]
    description: ACT3 jal-01 testcase
    parameters: [FIRMWARE_FILE=act3/jal-01.hex, GOLDEN_FILE=act3/jal-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_jalr_01:
    << : *sim
    filesets_append : [files_sim, files_act3_jalr_01]
    description: ACT3 jalr-01 testcase
    parameters: [FIRMWARE_FILE=act3/jalr-01.hex, GOLDEN_FILE=act3/jalr-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_lb_align_01:
    << : *sim
    filesets_append : [files_sim, files_act3_lb_align_01]
    description: ACT3 lb-align-01 testcase
    parameters: [FIRMWARE_FILE=act3/lb-align-01.hex, GOLDEN_FILE=act3/lb-align-01.signature, SIGNATURE_FILE=signature.output, TEST_ENV=ACT3, VERBOSE=false]

  sim_compliance_act3_lbu_align_01:
    << : *sim
