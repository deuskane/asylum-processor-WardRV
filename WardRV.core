#=========================================
scripts :
#=========================================
# Hooks of cosim_openocd (cwd = work_root, files copied in openocd/)

  rbb_build :
    cmd : [gcc, -shared, -fPIC, -O2, -Wall, -o, librbb.so, openocd/remote_bitbang.c]

  openocd_launch :
    cmd : [bash, openocd/launch.sh]

  openocd_check :
    cmd : [bash, openocd/check.sh]

# pre_run hook of lint_ghdl_synth_* (cwd = work_root)

  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  FIRMWARE_FILE :
    description : Firmware
    datatype    : str
    default     : firmware.hex
    paramtype   : generic

  GOLDEN_FILE :
    description : Golden signature file
    datatype    : str
    default     : golden.hex
    paramtype   : generic

  SIGNATURE_FILE :
    description : Signature dump file (signature area compared with GOLDEN_FILE at the end of the test)
    datatype    : str
    default     : signature.output
    paramtype   : generic

  TEST_ENV :
    description : Test environment (ACT3 tohost + signature, ACT4 self-checking)
    datatype    : str
    default     : ACT3
    paramtype   : generic

  VERBOSE :
    description : Verbose mode
    datatype    : bool
    default     : true
    paramtype   : generic

  EBREAK_EXCEPTION :
    description : WardRV_fsm - EBREAK raises a breakpoint exception
    datatype    : bool
    default     : false
    paramtype   : generic

  #---------------------------------------
  # Generics of WardRV_wrapper (lint_ghdl_synth_*)
  #---------------------------------------
  DEBUG_ENABLE :
    description : true, debug unit (WardRV_debug) instantiated
    datatype    : bool
    default     : true
    paramtype   : generic

  NB_TRIGGERS :
    description : Number of triggers
    datatype    : int
    default     : 2
    paramtype   : generic

  SBA_ENABLE :
    description : true, system bus access
    datatype    : bool
    default     : false
    paramtype   : generic

  RESETHALTREQ_ENABLE :
    description : true, halt on reset request supported
    datatype    : bool
    default     : false
    paramtype   : generic

  PROGBUF_SIZE :
    description : Size of the program buffer (words)
    datatype    : int
    default     : 2
    paramtype   : generic

  DATA_COUNT :
    description : Number of data registers
    datatype    : int
    default     : 2
    paramtype   : generic
