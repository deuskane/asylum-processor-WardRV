#=========================================
scripts :
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

  #---------------------------------------
  # Hooks of sim_dbg_openocd_* (cwd = work_root)
  #---------------------------------------
  cosim_build :
    cmd : [bash, openocd/cosim.sh, build]

  cosim_start :
    cmd : [bash, openocd/cosim.sh, start]

  cosim_check :
    cmd : [bash, openocd/cosim.sh, check]

#=========================================
parameters :
#=========================================

  FIRMWARE_FILE :
    description : Firmware
    datatype    : str
    default     : firmware.hex
    paramtype   : generic

  GOLDEN_FILE :
    description : Golden signature file
    datatype    : str
    default     : golden.hex
    paramtype   : generic

  SIGNATURE_FILE :
    description : Signature dump file (signature area compared with GOLDEN_FILE at the end of the test)
    datatype    : str
    default     : signature.output
    paramtype   : generic

  TEST_ENV :
    description : Test environment (ACT3 tohost + signature, ACT4 self-checking)
    datatype    : str
    default     : ACT3
    paramtype   : generic

  VERBOSE :
    description : Verbose mode
    datatype    : bool
    default     : true
    paramtype   : generic

  #---------------------------------------
  # Debug unit testbenches
  #---------------------------------------
  TEST :
    description : Scenario of the debug unit testbenches (run time)
    datatype    : str
    default     : ""
    paramtype   : generic

  EBREAK_EXCEPTION :
    description : tb_WardRV_debug - EBREAK raises a breakpoint exception
    datatype    : bool
    default     : false
    paramtype   : generic

  PROGBUF_SIZE :
    description : Debug Module - program buffer size in words
    datatype    : int
    default     : 2
    paramtype   : generic

  DATA_COUNT :
    description : Debug Module - number of data registers
    datatype    : int
    default     : 2
    paramtype   : generic

  SBA_ENABLE :
    description : Debug Module - System Bus Access
    datatype    : bool
    default     : true
    paramtype   : generic

  NB_TRIGGERS :
    description : WardRV_fsm - number of triggers
    datatype    : int
    default     : 2
    paramtype   : generic

  CLK_PERIOD_NS :
    description : tb_WardRV_dbg_jtag - clk period in ns (TCK period 50 ns)
    datatype    : int
    default     : 10
    paramtype   : generic

  #---------------------------------------
  # Generics of WardRV_wrapper (lint_ghdl_synth_*), the debug generics
  # below are also used by the testbenches
  #---------------------------------------
  DEBUG_ENABLE :
    description : WardRV_fsm - debug mode (and WardRV_debug in WardRV_wrapper)
    datatype    : bool
    default     : false
    paramtype   : generic

  RESETHALTREQ_ENABLE :
    description : WardRV_fsm and Debug Module - halt on reset request
    datatype    : bool
    default     : false
    paramtype   : generic

  IADDR_WIDTH :
    description : Width of iaddr_o
    datatype    : int
    default     : 30
    paramtype   : generic

  IADDR_ALIGN_BITS :
    description : Number of PC LSBs dropped on iaddr_o (2 = word address)
    datatype    : int
    default     : 2
    paramtype   : generic
