#=========================================
parameters :
#=========================================

  FIRMWARE_FILE :
    description : Firmware
    datatype    : str
    default     : firmware.hex
    paramtype   : generic

  GOLDEN_FILE :
    description : Golden signature file
    datatype    : str
    default     : golden.hex
    paramtype   : generic

  SIGNATURE_FILE :
    description : Signature dump file (signature area compared with GOLDEN_FILE at the end of the test)
    datatype    : str
    default     : signature.output
    paramtype   : generic

  TEST_ENV :
    description : Test environment (ACT3 tohost + signature, ACT4 self-checking)
    datatype    : str
    default     : ACT3
    paramtype   : generic

  VERBOSE :
    description : Verbose mode
    datatype    : bool
    default     : true
    paramtype   : generic
