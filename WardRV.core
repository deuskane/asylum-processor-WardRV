CAPI=2:

#-----------------------------------------------------------------------------
# Title      : WardRV Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : WardRV.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-01-24  0.0.1    mrosiere Created
# 2026-06-02  0.0.2    mrosiere fsm : add state trap
# 2026-09-15  0.0.3    mrosiere fsm : use ram2r1w
# 2026-10-05  0.0.4    mrosiere fsm : fix CSRRC/CSRRCI and BLT/BGE on signed overflow
#                               Compare compliance signature (SIGNATURE_FILE)
#                               Fix default/lint_nxmap toplevel
#                               Compliance : ACT3 (esw/compliance_act3) and ACT4 (esw/compliance_act4) suites
#-----------------------------------------------------------------------------

name        : asylum:processor:WardRV:0.0.4
description : WardRV - Academic RISCV processor

#=========================================
filesets:
#=========================================
  #---------------------------------------
  files_hdl:
  #---------------------------------------
    files        :
      # Common package
      - hdl/RV_pkg.vhd
      - hdl/WardRV_pkg.vhd
      - hdl/WardRV_stats_pkg.vhd

      # Bridge
      - hdl/bridge/dmem2sbi.vhd
      - hdl/bridge/imem2sbi.vhd

      # Instruction Set Simulator
      - hdl/iss/WardRV_iss_pkg.vhd
      - hdl/iss/WardRV_iss.vhd

      # Debug Version
      #- hdl/debug/WardRV_debug_pkg.vhd
      #- hdl/debug/WardRV_debug.vhd

      # FSM Version
      - hdl/fsm/WardRV_decode_pkg.vhd
      - hdl/fsm/WardRV_fsm_fetch.vhd
      - hdl/fsm/WardRV_fsm_alu.vhd
      - hdl/fsm/WardRV_fsm_decode.vhd
      - hdl/fsm/WardRV_fsm_regfile.vhd
      - hdl/fsm/WardRV_fsm_memory.vhd
      - hdl/fsm/WardRV_fsm_csr.vhd
      - hdl/fsm/WardRV_fsm.vhd
      - hdl/fsm/sbi_WardRV_fsm.vhd

    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - ">=asylum:utils:pkg:1.0.0"
      - ">=asylum:component:ram:1.0.0"

  #---------------------------------------
  files_sim:
  #---------------------------------------
    files        :
      - sim/WardRV_vips.vhd                                          
      - sim/tb_WardRV_pkg.vhd                                        
      - sim/tb_WardRV.vhd                                            
      - sim/tb_WardRV_iss.vhd                                        
      - esw/testcase/firmware.hex                                    : {file_type : user, copyto : firmware.hex}

    file_type    : vhdlSource-2008
    depend :
      - bitvis:verification:uvvm
      
  #---------------------------------------
  # Compliance Testcases : one fileset per test
  #---------------------------------------
  files_act3_add_01:
    files:
      - esw/compliance_act3/benchs/add-01.hex       : {file_type : user, copyto : act3/add-01.hex}
      - esw/compliance_act3/benchs/add-01.signature : {file_type : user, copyto : act3/add-01.signature}

  files_act3_addi_01:
    files:
      - esw/compliance_act3/benchs/addi-01.hex       : {file_type : user, copyto : act3/addi-01.hex}
